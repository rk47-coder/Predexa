# Only this wallet address can see the Create market action after connecting.
NEXT_PUBLIC_ADMIN_WALLET=

# This wallet is explicitly treated as a normal user and never receives Create Market access.
NEXT_PUBLIC_NORMAL_USER_WALLET=

# Deployed testnet contracts. Leave blank until after testnet deployment.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=
NEXT_PUBLIC_COLLATERAL_TOKEN_ADDRESS=
NEXT_PUBLIC_COLLATERAL_DECIMALS=6

# Deployment-only values. Never expose a private key with NEXT_PUBLIC_.
# RPC_URL=
# DEPLOYER_PRIVATE_KEY=
# ADMIN_WALLET=
